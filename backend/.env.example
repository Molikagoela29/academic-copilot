# ── LLM (Ollama) ────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.2

# ── Embeddings & retrieval ──────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
MIN_SIMILARITY=0.25

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=1500

# ── Server ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
